# Fourni automatiquement par Railway quand tu relies la base PostgreSQL :
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Ton compte admin (créé au premier démarrage)
ADMIN_USERNAME=mohamed
ADMIN_PASSWORD=change-moi
ADMIN_NAME=محمد
# Code à donner aux salariés pour créer leur compte (laisser vide = inscriptions fermées)
JOIN_CODE=equipe2026
# Longue chaîne aléatoire (garde les sessions après un redémarrage)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire
